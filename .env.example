# Copy this file to .env.local and fill in the values.

# Public URL of the site (used in emails and Paystack callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Neon Postgres ── https://console.neon.tech → your project → Connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Auth.js ── generate with: npx auth secret   (or any long random string)
AUTH_SECRET=

# ── Google sign-in ── Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google  (+ your production URL)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Email (Nodemailer) ── Gmail: enable 2-Step Verification, then create an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=snowaregadgets@gmail.com
SMTP_PASS=
MAIL_FROM="Snoware Gadgets <snowaregadgets@gmail.com>"
# Where new-order alerts and contact messages are sent
ADMIN_EMAIL=snowaregadgets@gmail.com

# ── Paystack ── https://dashboard.paystack.com/#/settings/developers (use test keys first)
# Webhook URL: https://YOUR-DOMAIN/api/paystack/webhook
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# ── Cloudinary (product image uploads) ── https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Admin account created by `npm run db:seed` ──
ADMIN_PASSWORD=change-me-to-a-strong-password
