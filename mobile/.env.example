# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app.

# The website's URL. For a phone on the same Wi-Fi as your computer use its LAN IP,
# e.g. http://192.168.1.20:3000 (not localhost). In production: https://your-domain
EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Same Pusher app as the website (NEXT_PUBLIC_PUSHER_KEY / NEXT_PUBLIC_PUSHER_CLUSTER)
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=eu

# Google sign-in (development build only — not available in Expo Go)
# Web client ID = the website's AUTH_GOOGLE_ID (used as the ID token audience)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
